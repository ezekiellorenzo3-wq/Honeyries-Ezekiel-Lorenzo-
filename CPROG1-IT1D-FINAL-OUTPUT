# Grade Checker

while True:
    score = input("\nEnter your score (0-100) or type NO to exit: ").strip().upper()

    if score == "NO":
        print("\nThank you for using Grade Checker!")
        break

    if not score.isdigit():
        print("\nInvalid input. Please enter a number from 0-100 or type NO.")
        continue

    score = int(score)

    if 90 <= score <= 100:
        print("Grade: A")

    elif 80 <= score < 90:
        print("Grade: B")

    elif 75 <= score < 80:
        print("Grade: C")

    elif 0 <= score < 74:
        print("Invalid score.")

    else:
        print("Invalid score.")


# Temperature Converter


print("\nTemperature Converter")

while True:
    try:
        celsius = float(input("Enter Temperature in Celsius: "))
        break
    except ValueError:
        print("Invalid input. Please enter a valid number.")

fahrenheit = (celsius * 9 / 5) + 32

print("\nTemperature Conversion")
print(f"Celsius    : {celsius:.2f} ")
print(f"Fahrenheit : {fahrenheit:.2f} ")


# Circle Calculator


print("\nCircle Calculator")

while True:
    try:
        radius = float(input("Enter Radius: "))
        if radius >= 0:
            break
        else:
            print("Radius cannot be negative.")
    except ValueError:
        print("Invalid input. Please enter a valid number.")

pi = 3.1416

area = pi * radius ** 2
circumference = 2 * pi * radius

print("\nCircle Results")
print(f"Radius         : {radius:.2f}")
print(f"Area           : {area:.2f} ")
print(f"Circumference  : {circumference:.2f} ")

print("\nThank you!")